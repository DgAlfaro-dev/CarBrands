# Copy this file to .env and adjust only what you need.
# Every value is optional: without .env, compose uses the same defaults.

# Host port for PostgreSQL (use 5433 if 5432 is already taken on your
# machine by another database server).
POSTGRES_HOST_PORT=5432

# Host port for the API (Swagger will be at http://localhost:8080/swagger).
API_HOST_PORT=8080

# Credentials and database name for the container (local development only).
POSTGRES_DB=prueba_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Development | Production
ASPNETCORE_ENVIRONMENT=Development
